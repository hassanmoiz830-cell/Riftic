# Byte-compiled / cache
__pycache__/
*.py[cod]
*.pyc

# Virtual environments
venv/
.venv/
env/

# Earth Engine / Google credentials — never commit these
*credentials*.json
*service-account*.json
.config/earthengine/

# Streamlit local secrets
.streamlit/secrets.toml

# OS clutter
.DS_Store
Thumbs.db

# Editor folders
.vscode/
.idea/

# Downloaded raw annual report PDFs (large, and often copyrighted — don't commit)
reports/*.pdf

# Local demo/output data — regenerate via the pipeline instead of committing binary CSVs
# (remove this line if you DO want your data/ folder tracked so the dashboard works out of the box)
# data/
